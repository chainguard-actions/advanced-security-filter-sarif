{
  "version": "2.1.0",
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "TestTool",
          "rules": [
            {
              "id": "rule/critical",
              "name": "CriticalRule",
              "properties": {
                "security-severity": "9.5"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "rule/low",
              "name": "LowRule",
              "properties": {
                "security-severity": "2.0"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "rule/critical",
          "level": "error",
          "message": {
            "text": "Critical security issue"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/auth.py"
                }
              }
            }
          ]
        },
        {
          "ruleId": "rule/low",
          "level": "warning",
          "message": {
            "text": "Low severity issue"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/utils.py"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
